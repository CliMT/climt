# IDE config
.idea/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.c

# Fortran modules
*.mod
*.o
*.a

# Vim files
*.swp

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# pyenv python configuration file
.python-version

.vscode/

# macOS files
.DS_Store

# Jupyter Notebook checkpoints
.ipynb_checkpoints/.worktrees/

# Quarto site build output
docs/_site/
.quarto/

# Scratch experiments & outputs (preserved on disk, never tracked)
debug_data/
.ipynb_checkpoints/

# Quarto notebook render intermediates
docs/**/*_files/
docs/experiments/**/index.html
docs/experiments/**/*.out.ipynb

# Local AI-assistant configs (CLAUDE.md was dropped with graphify)
.claude/
.gemini/
GEMINI.md

# build-time data download cache (SST climatology, etc.)
build_cache/

# Agent scaffolding (task briefs, reports, review diffs). Matches the
# pre-existing .superpowers/sdd/.gitignore, which already ignores everything.
.superpowers/

# YSU Fortran build products. *.o/*.mod already cover most of them, but the
# linked driver executable has no extension so it slips through.
climt/_components/ysu/_capi/ysu_driver

# graphify knowledge-graph output. No longer carried in the repo; ignored so a
# stray `graphify update .` cannot re-commit ~120 MB of generated artifacts.
graphify-out/
